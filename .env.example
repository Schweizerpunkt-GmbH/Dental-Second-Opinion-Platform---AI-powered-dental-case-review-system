# Database Configuration
# Required: PostgreSQL connection string
# Format: postgresql://username:password@host:port/database
# Example: postgresql://user:pass@localhost:5432/dental_db
# Get free hosting from: https://neon.tech or https://supabase.com
DATABASE_URL=postgresql://user:password@host:5432/database_name

# Session Secret
# Required: Random string for session encryption (generate with: openssl rand -base64 32)
SESSION_SECRET=change-this-to-a-random-secure-string

# Application Configuration
NODE_ENV=production
PORT=5000
FRONTEND_URL=https://onlinezahnarzt.com

# Stripe Payment Configuration (Optional - for payment processing)
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_public_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Email Configuration (Optional - for notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=noreply@onlinezahnarzt.com

# Object Storage Configuration (Optional)
DEFAULT_OBJECT_STORAGE_BUCKET_ID=dental-uploads
PUBLIC_OBJECT_SEARCH_PATHS=/public
PRIVATE_OBJECT_DIR=/private

# Replit Configuration (Set to 1 for production deployment)
REPLIT_DEPLOYMENT=1
REPL_ID=production
REPLIT_DOMAINS=onlinezahnarzt.com
ISSUER_URL=https://onlinezahnarzt.com/oidc
